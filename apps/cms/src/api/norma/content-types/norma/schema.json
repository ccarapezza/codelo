{
  "kind": "collectionType",
  "collectionName": "normas",
  "info": {
    "singularName": "norma",
    "pluralName": "normas",
    "displayName": "Norma (Boletín Oficial)",
    "description": "Archivo de normas relevadas del Boletín Oficial con su texto íntegro y la ficha de lectura asistida por IA. Se sincroniza por cron; el análisis es editable a mano."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "url": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 500
    },
    "norma": {
      "type": "string"
    },
    "rubro": {
      "type": "string"
    },
    "organismo": {
      "type": "string"
    },
    "publicadaEl": {
      "type": "datetime"
    },
    "textoCompleto": {
      "type": "text"
    },
    "terminoOrigen": {
      "type": "string"
    },
    "syncedAt": {
      "type": "datetime",
      "required": true
    },
    "analisisEstado": {
      "type": "enumeration",
      "enum": ["pendiente", "listo", "descartada", "error"],
      "default": "pendiente",
      "required": true
    },
    "relevancia": {
      "type": "integer",
      "min": 0,
      "max": 3
    },
    "relevanciaMotivo": {
      "type": "text"
    },
    "resumen": {
      "type": "text"
    },
    "queCambia": {
      "type": "json"
    },
    "aQuienAfecta": {
      "type": "json"
    },
    "pasos": {
      "type": "json"
    },
    "normasCitadas": {
      "type": "json"
    },
    "vigencia": {
      "type": "string"
    },
    "analizadaEl": {
      "type": "datetime"
    },
    "analisisModelo": {
      "type": "string"
    },
    "analisisError": {
      "type": "text"
    }
  }
}
