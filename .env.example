# Shared settings
NODE_ENV=development

# Redis (optional — note port 6381)
REDIS_URL=redis://localhost:6381

# Strapi CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3200

# Strapi rate limit for /api/* per IP (defaults: 60 req / 60s)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Redis password (production). Compose injects via REDIS_URL=redis://:<pwd>@redis:6379
REDIS_PASSWORD=generate-a-long-random-string

# OpenAI key consumed by the CMS (agentes IA + portadas)
OPENAI_API_KEY=sk-...

# Optional: organization Admin key (sk-admin-...), ONLY to show usage and cost in
# the admin. It is NOT the application key and it does not generate anything:
# without it the panel simply says so. Settings -> Organization -> Admin keys.
OPENAI_ADMIN_KEY=

# OpenRouter key — only needed if you select a google/gemini-* (Nano Banana) image
# model in Site Settings.
OPENROUTER_API_KEY=

# ── Identidad de la instalación ──
# Identifica la instalación. Prefija las claves internas y los contenedores.
# En producción NO tiene default: sin esto la siembra y la migración de i18n se saltean.
PROJECT_SLUG=nib
# Nombre de la instalación (distinto de la marca editorial, que se edita en el panel).
PROJECT_NAME=Nib
# URL pública del SITIO. De acá salen el dominio de las placas y el User-Agent del RSS.
SITE_PUBLIC_URL=http://localhost:3400
# Zona horaria de los schedules y los crons.
AGENT_SCHEDULE_TZ=America/Argentina/Buenos_Aires
# Código del locale en el que se escribe.
DEFAULT_LOCALE=es
# Código del locale al que se traduce (si autoTranslate está activo).
TRANSLATION_LOCALE=en

# Ruido de Strapi en el panel. Apagados por defecto; poner `true` los devuelve.
#   FLAG_NPS         la encuesta "¿recomendarías Strapi?"
#   FLAG_PROMOTE_EE  la promoción de la edición Enterprise
FLAG_NPS=false
FLAG_PROMOTE_EE=false
